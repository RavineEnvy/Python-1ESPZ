    "#Ex. 1\n",
    "def soma_ate(n):\n",
    "    total = 0\n",
    "    for i in range(1, n + 1):\n",
    "        total= total + i\n",
    "    return total\n",
    "\n",
    "#Ex. 2\n",
    "def soma_ate2(n):\n",
    "    return n * (n + 1) // 2\n",
    "\n",
    "\n",
    "print(soma_ate(6))\n",
    "print(soma_ate2(6))"
   ]
